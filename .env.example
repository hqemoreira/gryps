# Copy to .env.local for local Next.js development.
# Never commit .env.local — it is gitignored.
# Sync the same keys to Vercel → Project → Settings → Environment Variables
# (or: vercel env add).

# Neon (PostgreSQL) — required for Advisor submissions, signatures, contact, unlock
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Mistral AI — optional; recommendation prose only (score stays deterministic)
MISTRAL_API_KEY=your_mistral_api_key

# Resend (transactional email) — Advisor unlock magic links + contact
RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM=GRYPS <hello@example.com>

# Optional — canonical origin for magic-link URLs (prefer over preview host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
