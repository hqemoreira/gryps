{
  "name": "gryps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:score": "npx --yes tsx scripts/verify-deterministic.ts",
    "test:evidence": "npx --yes tsx scripts/verify-evidence-integrity.ts",
    "test:dependency-lab": "npx --yes tsx scripts/verify-dependency-research-panel.ts",
    "test:evidence-pack": "npx --yes tsx scripts/verify-nordic-lapland-evidence-pack.ts",
    "test:evidence-intake": "npx --yes tsx scripts/verify-evidence-intake.ts",
    "test:fixtures": "npx --yes tsx scripts/verify-provider-dependency-fixtures.ts",
    "test:boundaries": "npx --yes tsx scripts/verify-protected-boundaries.ts",
    "test:workflow": "npx --yes tsx scripts/verify-research-workflow.ts",
    "test:workflow-integrity": "npx --yes tsx scripts/verify-workflow-integrity.ts",
    "test:evidence-binder": "npx --yes tsx scripts/verify-evidence-binder.ts",
    "test:evidence-annotations": "npx --yes tsx scripts/verify-evidence-annotations.ts",
    "test:qa-agents": "npx --yes tsx scripts/verify-multi-agent-qa.ts",
    "test:task-qa": "npx --yes tsx scripts/verify-task-qa.ts",
    "test:qa-execution": "npx --yes tsx scripts/verify-qa-execution.ts",
    "test:qa-live": "npx --yes tsx scripts/verify-live-qa.ts",
    "test:research-qa": "npm run test:fixtures && npm run test:evidence-pack && npm run test:evidence-intake && npm run test:dependency-lab && npm run test:evidence && npm run test:evidence-binder && npm run test:evidence-annotations && npm run test:workflow-integrity && npm run test:boundaries && npm run test:workflow && npm run test:qa-agents && npm run test:task-qa && npm run test:qa-execution",
    "seo:gsc": "npx --yes tsx scripts/seo/pull-gsc.ts",
    "seo:planner": "npx --yes tsx scripts/seo/pull-planner.ts",
    "seo:propose": "npx --yes tsx scripts/seo/propose-pages.ts",
    "seo:setup-gsc": "powershell -ExecutionPolicy Bypass -File scripts/seo/setup-gsc.ps1 -Pull",
    "seo:weekly-comment": "npx --yes tsx scripts/seo/format-weekly-comment.ts"
  },
  "dependencies": {
    "@mistralai/mistralai": "^2.7.0",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vercel/analytics": "^2.0.1",
    "adm-zip": "^0.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "braces": "file:vendor/braces",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "googleapis": "^178.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "braces": "file:vendor/braces",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  }
